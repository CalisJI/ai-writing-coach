{
  "$schema": "https://json.schemastore.org/stylelintrc.json",
  "meta": {
    "name": "BECOMING Design Tokens",
    "version": "1.0.0",
    "direction": "Editorial Intelligence"
  },
  "color": {
    "canvas": "#F7F7F5",
    "surface": "#FFFFFF",
    "surfaceMuted": "#F0F1EF",
    "inkStrong": "#111214",
    "ink": "#303236",
    "inkMuted": "#72757B",
    "borderSubtle": "#E4E5E2",
    "borderStrong": "#D2D4D0",
    "accent600": "#FF6A1A",
    "accent500": "#FF7A2F",
    "accent100": "#FFF0E6",
    "positive": "#2F8F5B",
    "attention": "#D89B22",
    "important": "#D75B45",
    "informational": "#3F70C8"
  },
  "font": {
    "displayLatin": "Roboto Condensed, Arial Narrow, sans-serif",
    "uiLatin": "Inter, system-ui, sans-serif",
    "cjk": "Noto Sans SC, PingFang SC, Microsoft YaHei, sans-serif"
  },
  "fontSize": {
    "meta": "12px",
    "ui": "14px",
    "body": "16px",
    "bodyLarge": "18px",
    "h3": "22px",
    "h2": "28px",
    "h1": "36px",
    "displayLarge": "48px",
    "displayXL": "64px"
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px"
  },
  "radius": {
    "small": "8px",
    "control": "10px",
    "object": "14px",
    "surface": "18px",
    "hero": "22px"
  },
  "shadow": {
    "none": "none",
    "level1": "0 1px 2px rgba(17,18,20,.05), 0 4px 12px rgba(17,18,20,.04)",
    "level2": "0 8px 28px rgba(17,18,20,.08)",
    "overlay": "0 16px 48px rgba(17,18,20,.14)"
  },
  "motion": {
    "micro": "150ms",
    "standard": "220ms",
    "reveal": "300ms",
    "milestone": "600ms"
  },
  "layout": {
    "contentMax": "1440px",
    "readingMax": "760px",
    "editorDesktopPreferred": "64%",
    "feedbackDesktopPreferred": "36%"
  },
  "mastery": [
    "Emerging",
    "Developing",
    "Stable",
    "Mastered"
  ]
}
