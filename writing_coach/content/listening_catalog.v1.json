      "segments": [
        {
          "segment_id": "commons-zh-lesson-1-dialogue-2:000",
          "start_ms": 415,
          "end_ms": 1364,
          "original_text": "\u91d1\u59ae\uff1a\u4ed6\u4eec\u662f\u8c01\uff1f",
          "pinyin": "J\u012bnn\u00ed: T\u0101men sh\u00ec sh\u00e9i?",
          "translations": {"vi": "Ginny: H\u1ecd l\u00e0 ai?", "en": "Ginny: Who are they?"}
        },
        {
          "segment_id": "commons-zh-lesson-1-dialogue-2:001",
          "start_ms": 2864,
          "end_ms": 7924,
          "original_text": "\u6b27\u6587\uff1a\u5979\u662f\u827e\u7f8e\uff0c\u5979\u662f\u4e2d\u56fd\u4eba\u3002\u4ed6\u662f\u4e1c\u5c3c\uff0c\u4ed6\u662f\u7f8e\u56fd\u4eba\u3002",
          "pinyin": "\u014cuw\u00e9n: T\u0101 sh\u00ec \u00c0im\u011bi, t\u0101 sh\u00ec Zh\u014dnggu\u00f3r\u00e9n. T\u0101 sh\u00ec D\u014dngn\u00ed, t\u0101 sh\u00ec M\u011bigu\u00f3r\u00e9n.",
          "translations": {"vi": "Owen: C\u00f4 \u1ea5y l\u00e0 Amy, ng\u01b0\u1eddi Trung Qu\u1ed1c. Anh \u1ea5y l\u00e0 Tony, ng\u01b0\u1eddi M\u1ef9.", "en": "Owen: She is Amy, and she is Chinese. He is Tony, and he is American."}
        },
        {
          "segment_id": "commons-zh-lesson-1-dialogue-2:002",
          "start_ms": 10018,
          "end_ms": 11627,
          "original_text": "\u91d1\u59ae\uff1a\u4f60\u4e5f\u662f\u7f8e\u56fd\u4eba\u5417\uff1f",
          "pinyin": "J\u012bnn\u00ed: N\u01d0 y\u011b sh\u00ec M\u011bigu\u00f3r\u00e9n ma?",
          "translations": {"vi": "Ginny: B\u1ea1n c\u0169ng l\u00e0 ng\u01b0\u1eddi M\u1ef9 \u00e0?", "en": "Ginny: Are you also American?"}
        },
        {
          "segment_id": "commons-zh-lesson-1-dialogue-2:003",
          "start_ms": 12994,
          "end_ms": 18115,
          "original_text": "\u6b27\u6587\uff1a\u4e0d\u662f\uff0c\u6211\u662f\u82f1\u56fd\u4eba\u3002\u4f60\u5462\uff1f\u4f60\u662f\u54ea\u56fd\u4eba\uff1f",
          "pinyin": "\u014cuw\u00e9n: B\u00fa sh\u00ec, w\u01d2 sh\u00ec Y\u012bnggu\u00f3r\u00e9n. N\u01d0 ne? N\u01d0 sh\u00ec n\u01ce gu\u00f3 r\u00e9n?",
          "translations": {"vi": "Owen: Kh\u00f4ng, t\u00f4i l\u00e0 ng\u01b0\u1eddi Anh. C\u00f2n b\u1ea1n? B\u1ea1n l\u00e0 ng\u01b0\u1eddi n\u01b0\u1edbc n\u00e0o?", "en": "Owen: No, I'm British. How about you? What nationality are you?"}
        },
        {
          "segment_id": "commons-zh-lesson-1-dialogue-2:004",
          "start_ms": 19661,
          "end_ms": 20637,
          "original_text": "\u91d1\u59ae\uff1a\u6211\u662f\u6cd5\u56fd\u4eba\u3002",
          "pinyin": "J\u012bnn\u00ed: W\u01d2 sh\u00ec F\u01cegu\u00f3r\u00e9n.",
          "translations": {"vi": "Ginny: T\u00f4i l\u00e0 ng\u01b0\u1eddi Ph\u00e1p.", "en": "Ginny: I'm French."}
        }
      ]
    }
