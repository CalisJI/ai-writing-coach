        {
          "segment_id": "commons-voa-anna-pen:000",
          "start_ms": 517,
          "end_ms": 2336,
          "original_text": "Anna, do you have a pen?",
          "translations": {
            "vi": "Anna, b\u1ea1n c\u00f3 b\u00fat kh\u00f4ng?",
            "zh": "\u5b89\u5a1c\uff0c\u4f60\u6709\u7b14\u5417\uff1f"
          }
        },
        {
          "segment_id": "commons-voa-anna-pen:001",
          "start_ms": 3581,
          "end_ms": 7885,
          "original_text": "Yes. I have a pen in my bag.",
          "translations": {
            "vi": "C\u00f3. M\u00ecnh c\u00f3 m\u1ed9t c\u00e2y b\u00fat trong t\u00fai.",
            "zh": "\u6709\u3002\u6211\u7684\u5305\u91cc\u6709\u4e00\u652f\u7b14\u3002"
          }
        }
      ]
    },
    {
      "source_media_id": "commons-taxi-dialogue-1",
      "source_url": "https://commons.wikimedia.org/wiki/File:Dialogue1.ogg",
      "source_provider": "wikimedia-commons",
      "source_type": "licensed-audio",
      "source_title": "Taxi Language dialogue 1",
      "source_creator": "Ferenc6 / Taxi Language Wikibook",
      "language": "en",
      "duration_ms": 71138,
      "playback": {
        "provider": "wikimedia-commons",
        "kind": "audio",
        "url": "https://commons.wikimedia.org/wiki/Special:Redirect/file/Dialogue1.ogg"
      },
      "rights": {
