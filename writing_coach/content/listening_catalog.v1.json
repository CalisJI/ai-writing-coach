      },
      "segments": [
        {
          "segment_id": "commons-taxi-dialogue-1:000",
          "start_ms": 0,
          "end_ms": 71138,
          "original_text": "Oh no! It's raining! Taxi! Taxi! I need a taxi. Taxi! Taxi! Oh no, I'm in a hurry! I'm going to be late! Taxi! Taxi! It's eight o'clock already. Taxi! Taxi! I see you're in a hurry. Do you need a taxi? Yes, I'm really late. I need a taxi. Taxi! Phew! Thanks a lot. You're welcome.",
          "translations": {
            "vi": "\u00d4i kh\u00f4ng, tr\u1eddi \u0111ang m\u01b0a! Taxi! T\u00f4i c\u1ea7n m\u1ed9t chi\u1ebfc taxi. T\u00f4i \u0111ang v\u1ed9i v\u00e0 s\u1eafp mu\u1ed9n. \u0110\u00e3 t\u00e1m gi\u1edd r\u1ed3i. B\u1ea1n c\u00f3 c\u1ea7n taxi kh\u00f4ng? C\u00f3, t\u00f4i mu\u1ed9n th\u1eadt r\u1ed3i. C\u1ea3m \u01a1n r\u1ea5t nhi\u1ec1u. Kh\u00f4ng c\u00f3 g\u00ec.",
            "zh": "\u7cdf\u4e86\uff0c\u4e0b\u96e8\u4e86\uff01\u51fa\u79df\u8f66\uff01\u6211\u9700\u8981\u4e00\u8f86\u51fa\u79df\u8f66\u3002\u6211\u5f88\u7740\u6025\uff0c\u8981\u8fdf\u5230\u4e86\u3002\u5df2\u7ecf\u516b\u70b9\u4e86\u3002\u4f60\u9700\u8981\u51fa\u79df\u8f66\u5417\uff1f\u662f\u7684\uff0c\u6211\u771f\u7684\u8fdf\u5230\u4e86\u3002\u975e\u5e38\u611f\u8c22\u3002\u4e0d\u5ba2\u6c14\u3002"
          }
        }
      ]
    },
