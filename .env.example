# AI model used by the Writing Coach
OLLAMA_MODEL=qwen3:8b

# Ollama runs natively on the Windows host.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT=180

# Recommended: do not silently create fake demo scores if Ollama is unavailable.
ALLOW_FALLBACK=false

# Optional for local development. Required for production-like tunnel staging;
# never commit the real token.
CLOUDFLARE_TUNNEL_TOKEN=

# Safe local/developer defaults. This example supports:
#   Copy-Item .env.example .env
#   docker compose up -d --build
APP_ENV=development
APP_BIND_HOST=0.0.0.0
PUBLIC_BASE_URL=http://127.0.0.1:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit override. Normally derived as PUBLIC_BASE_URL/auth/google/callback.
GOOGLE_REDIRECT_URI=
SESSION_SECRET=
BOOTSTRAP_OWNER_EMAIL=


# Optional platform AI providers - developer/server config only
PLATFORM_ADMIN_EMAILS=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
CLOUD_AI_TIMEOUT=180

# Isolated developer/test persistence only. SQLite is NOT authoritative
# production persistence and is never a production fallback.
PERSISTENCE_BACKEND=sqlite
POSTGRES_RUNTIME_URL=
# Migration, rehearsal, and parity only; never a runtime selector.
POSTGRES_SHADOW_URL=
# Production-like staging requires PERSISTENCE_BACKEND=postgresql,
# POSTGRES_RUNTIME_URL, APP_BIND_HOST=127.0.0.1, OAuth/session secrets, and
# CLOUDFLARE_TUNNEL_TOKEN. Validate an ignored local .env before staging:
# python scripts/validate_public_staging_readiness.py --env-file .env
