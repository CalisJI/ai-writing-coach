# AI model used by the Writing Coach
OLLAMA_MODEL=qwen3:8b

# Ollama runs natively on the Windows host.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT=180

# Recommended: do not silently create fake demo scores if Ollama is unavailable.
ALLOW_FALLBACK=false

# Optional. Only needed for: docker compose --profile public up -d
# Create a named Cloudflare Tunnel first, then paste its token here.
CLOUDFLARE_TUNNEL_TOKEN=

# Google multi-user login
APP_ENV=development
APP_BIND_HOST=0.0.0.0
PUBLIC_BASE_URL=http://127.0.0.1:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit override. Normally derived as PUBLIC_BASE_URL/auth/google/callback.
GOOGLE_REDIRECT_URI=
SESSION_SECRET=
BOOTSTRAP_OWNER_EMAIL=


# Optional platform AI providers - developer/server config only
PLATFORM_ADMIN_EMAILS=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
CLOUD_AI_TIMEOUT=180
