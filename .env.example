# AI model used by the Writing Coach
OLLAMA_MODEL=qwen3:8b

# Ollama runs natively on the Windows host.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT=180

# Recommended: do not silently create fake demo scores if Ollama is unavailable.
ALLOW_FALLBACK=false

# Optional. Only needed for: docker compose --profile public up -d
# Create a named Cloudflare Tunnel first, then paste its token here.
CLOUDFLARE_TUNNEL_TOKEN=
