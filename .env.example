# AI model used by the Writing Coach
OLLAMA_MODEL=qwen3:8b

# Ollama runs natively on the Windows host.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT=180

# Recommended: do not silently create fake demo scores if Ollama is unavailable.
ALLOW_FALLBACK=false

# Required for production-like tunnel staging. Never commit the real token.
CLOUDFLARE_TUNNEL_TOKEN=

# Production-like staging placeholders. Complete every secret locally before
# running scripts/validate_public_staging_readiness.py.
APP_ENV=production
APP_BIND_HOST=127.0.0.1
PUBLIC_BASE_URL=https://staging.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit override. Normally derived as PUBLIC_BASE_URL/auth/google/callback.
GOOGLE_REDIRECT_URI=
SESSION_SECRET=
BOOTSTRAP_OWNER_EMAIL=


# Optional platform AI providers - developer/server config only
PLATFORM_ADMIN_EMAILS=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro
CLOUD_AI_TIMEOUT=180

# Authoritative product persistence. This must be a postgresql+psycopg URL.
PERSISTENCE_BACKEND=postgresql
POSTGRES_RUNTIME_URL=
# Migration, rehearsal, and parity only; never a runtime selector.
POSTGRES_SHADOW_URL=
# SQLite is permitted only for isolated developer/testing use. It is not a
# production fallback and the frozen SQLite volume remains archive evidence.
